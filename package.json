{
  "name": "dsh-session-reference-ux-patch",
  "version": "0.1.0",
  "private": true,
  "description": "Durable, reversible installer for DSH session-reference UX patches",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-session-reference-ux-patch": "./bin/patch.mjs"
  },
  "files": [
    "bin",
    "lib",
    "patches",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check bin/patch.mjs && node bin/patch.mjs doctor",
    "apply": "node bin/patch.mjs apply",
    "doctor": "node bin/patch.mjs doctor",
    "restore": "node bin/patch.mjs restore"
  },
  "license": "MIT"
}
